# OpenAI key — read ONLY by /api/* route handlers, never shipped to the browser.
# Copy to .env.local for local dev; set in Vercel project env for preview/prod.
OPENAI_API_KEY=sk-...

# Cost-saving local defaults for the persona-chat sandbox. All are server-only.
PERSONA_MODEL=gpt-5.4-mini
PERSONA_REASONING_EFFORT=low
PERSONA_IMAGE_DETAIL=low
CHAT_MODEL=gpt-5.4-mini
CHAT_REASONING_EFFORT=low

# Suggested production quality overrides:
# PERSONA_MODEL=gpt-5.6
# PERSONA_REASONING_EFFORT=high
# PERSONA_IMAGE_DETAIL=high
# CHAT_MODEL=gpt-5.5
# CHAT_REASONING_EFFORT=low
